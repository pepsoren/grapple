{
  "name": "grapple-ui",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:build": "pnpm build && CARGO_TARGET_DIR=../../target/app cargo build -p grapple --release --features custom-protocol",
    "app:install": "pnpm app:build && bash ../../scripts/install-linux.sh",
    "app:build:mock": "pnpm build && CARGO_TARGET_DIR=../../target/app-mock cargo build -p grapple --release --no-default-features --features mock,custom-protocol"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
